WHITESPACE   =  _{ " " | "\t" | "\n" }

alpha = { 'a'..'z' | 'A'..'Z' }
digit = { '0'..'9' }
separator = { "-" }
ident = { alpha ~ (alpha | digit)* ~ (separator ~ (alpha | digit)+)* }

and = { "&&" }
or  = { "||" }
op  = _{ and | or }

broadcast           = @{ "*" }
dimension           = @{ ident }
attribute           = @{ broadcast | ident }
version_number      = @{ digit+ }
tag                 = @{ ident }
delim               = _{ "::" }
version             = _{ "@" ~ (version_number | tag) }
qualified_attribute = { dimension ~ delim ~ attribute ~ !delim  ~ version? }
block               = _{ qualified_attribute | "(" ~ eq ~ ")" }
eq                  = { block ~ (op ~ block)* }
policy              = _{ broadcast | eq }